# -----------------------------------------------------------------------------
# App Friends — environment variables
# Copy to `.env` and fill in. Local dev defaults are noted in comments.
# -----------------------------------------------------------------------------

# Database (Postgres 16). Port 5455 to avoid collisions with other local
# Postgres instances. Spin up with `pnpm up`.
DATABASE_URL="postgresql://appfriends:appfriends@localhost:5455/appfriends"

# -----------------------------------------------------------------------------
# Auth (NextAuth 5)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=""
AUTH_URL="http://localhost:3050"
# NextAuth v5 trusts the host in dev; set true if running behind a proxy.
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: $AUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: $AUTH_URL/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Sign in with Apple — https://developer.apple.com/account/resources/identifiers
# AUTH_APPLE_ID is the Services ID; AUTH_APPLE_SECRET is a signed client secret JWT.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# -----------------------------------------------------------------------------
# SDK signing — tokens issued at impression time and echoed on tap/install.
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
SDK_TOKEN_SECRET=""

# Encryption key for App Store Connect private keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32   (decodes to 32 bytes)
ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Upstash Redis — rate-limit + event dedupe. Optional in dev (falls back to
# in-memory). Create at https://console.upstash.com.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Email — Dev: MailHog (http://localhost:8055). Prod: Resend.
# -----------------------------------------------------------------------------
EMAIL_FROM="App Friends <noreply@appfriends.dev>"
MAILHOG_HOST="localhost"
MAILHOG_PORT="1055"
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Stripe — Pro subscription + sponsored campaign spend.
# Webhook endpoint: $AUTH_URL/api/v1/webhooks/stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""           # recurring price for the Pro plan

# -----------------------------------------------------------------------------
# Vercel Blob — uploaded promo creative (icons, screenshots).
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3050"
# Vercel cron secret — sent in the Authorization header on scheduled runs.
CRON_SECRET=""
