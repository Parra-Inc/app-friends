{
  "name": "app-friends-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:force": "bash scripts/dev.sh --force",
    "dev:servers": "concurrently -n web,studio -c magenta,cyan \"next dev --turbopack --port 3050\" \"prisma studio --port 5575 --browser none\"",
    "dev:web": "next dev --turbopack --port 3050",
    "build": "prisma generate && next build",
    "start": "next start --port 3050",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio --port 5575 --browser none",
    "db:generate": "prisma generate",
    "db:sync": "prisma format && prisma generate && prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/blob": "^2.3.1",
    "@vercel/og": "^0.11.1",
    "dotenv": "^17.3.1",
    "jose": "^6.2.2",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.0",
    "stripe": "^17.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
