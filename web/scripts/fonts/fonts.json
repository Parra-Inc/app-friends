      "fallbackCss": "@font-face { font-family: \"Newsreader Fallback\"; src: local(\"Times New Roman\"); ascent-override: 69.68%; descent-override: 25.12%; line-gap-override: 0.0%; size-adjust: 105.48%; }",
      "variable": "--font-newsreader",
      "renderedBy": "scripts/fonts/coverage-newsreader.json"
    }
  ]
